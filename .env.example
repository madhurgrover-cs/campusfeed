# Used by Docker Compose to create the local PostgreSQL role.
POSTGRES_USER=campusfeed_user
POSTGRES_PASSWORD=change_me_for_local_development

# Used by FastAPI and Alembic.
DATABASE_URL=postgresql+psycopg://campusfeed_user:change_me_for_local_development@localhost:5432/campusfeed

# Used by FastAPI to sign JWT access tokens. Generate a real secret for any
# non-local environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_for_local_development

# Bearer token the AI-engine pipeline (ai-engine/) uses to call POST /api/v1/ingest.
# Grants access to that endpoint only - not a user account. Generate a real secret
# for any non-local environment the same way as JWT_SECRET_KEY above.
INGEST_SERVICE_TOKEN=change_me_for_local_development
